{
  "name": "dsh-scholar-digest",
  "version": "0.1.2",
  "description": "Closes the gap in batch-searching CNKI (知网) literature with an agent: an academic research preset for DeepSeek Harness that maps CNKI Space metadata links to openable kns.cnki.net pages and adds arXiv, PubMed and Semantic Scholar, plus the download-paper skill that produces one topic directory with an offline HTML index, XLSX table, BibTeX, RIS and an arXiv download script.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/**/*.js",
    "skills/**",
    "servers/cnki-search/src/**",
    "servers/cnki-search/pyproject.toml",
    "servers/cnki-search/uv.lock",
    "servers/cnki-search/LICENSE",
    "servers/cnki-search/README.md",
    "servers/cnki-search/CHANGES.md",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent-preset",
    "skill",
    "literature",
    "literature-review",
    "cnki",
    "arxiv",
    "pubmed",
    "semantic-scholar",
    "bibtex",
    "ris"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiYang-cyber/dsh-scholar-digest.git"
  },
  "homepage": "https://github.com/LiYang-cyber/dsh-scholar-digest#readme",
  "bugs": {
    "url": "https://github.com/LiYang-cyber/dsh-scholar-digest/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.1+": "compatible"
      }
    }
  }
}
